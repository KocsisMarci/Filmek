<Window x:Class="Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Filmek"
        mc:Ignorable="d"
        Title="Filmek" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Filmek betöltése" Width="150" Height="30" Margin="10 10" Click="Button_Click"></Button>
            <Button Content="Hány film van?" Width="150" Height="30" Margin="10  10" Click="Button_Click_1"></Button>
            <Button Content="Leghosszabb film" Width="150" Height="30" Margin="10 10" Click="Button_Click_2"></Button>
            <Button Content="Átlag értékelés" Width="150" Height="30" Margin="10 10" Click="Button_Click_3"></Button>
            <Button Content="Csak Sci-fi" Width="150" Height="30" Margin="10 10" Click="Button_Click_4"></Button>
            <Button Content="Csak Shrek" Width="150" Height="30" Margin="10 10" Click="Button_Click_5"></Button>
            <Button Content="Rendezés cím szerint" Width="150" Height="30" Margin="10 10" Click="Button_Click_6"></Button>

            <ProgressBar x:Name="progress" Width="150" Height="25" Margin="10 20 10 10"></ProgressBar>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <DataGrid x:Name="dataGrid" Width="500" Margin="0 50 0 0" Height="300" SelectionChanged="dataGrid_SelectionChanged"></DataGrid>
        </StackPanel>
        
    </Grid>
</Window>
